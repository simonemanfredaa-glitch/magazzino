rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signed() { return request.auth != null && request.auth.token.email != null; }
    function email() { return request.auth.token.email.lower(); }
    function ruoli() { return get(/databases/$(database)/documents/config/ruoli).data; }
    function hasRuoli() { return exists(/databases/$(database)/documents/config/ruoli); }
    function admin() { return signed() && (email() == 'simonemanfredaa@gmail.com' || (hasRuoli() && email() in ruoli().get('admin', []))); }
    function producer() { return admin() || (signed() && hasRuoli() && email() in ruoli().get('producer', [])); }
    function only(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function owner() { return signed() && resource.data.owner == request.auth.uid; }
    function collab() { return signed() && email() in resource.data.get('collab', []); }

    // inventario: tutti leggono; chiunque può segnare "da ricomprare"; il resto solo admin
    match /articoli/{id} {
      allow read: if true;
      allow update: if admin() || (only(['finendo']) && request.resource.data.finendo is bool);
      allow create, delete: if admin();
    }
    // liste: lette da tutti (servono per calcolare la disponibilità).
    // Le crea un producer; le modifica chi l'ha creata, i suoi collaboratori e l'admin;
    // il PA con il link può solo segnare preso / rientro / note.
    match /liste/{id} {
      allow read: if true;
      allow create: if producer() && request.resource.data.owner == request.auth.uid;
      allow update: if admin()
        || (owner() && request.resource.data.owner == request.auth.uid)
        || (collab() && only(['nome', 'per', 'righe', 'extra', 'stato']))
        || only(['stato']);
      allow delete: if admin() || owner() || collab();
    }
    // note dal QR: chiunque le scrive, solo admin le chiude
    match /note/{id} {
      allow read: if true;
      allow create: if request.resource.data.fatto == false && request.resource.data.testo is string && request.resource.data.testo.size() <= 500;
      allow update, delete: if admin();
    }
    match /storico/{id} {
      allow read: if true;
      allow create: if signed();
      allow update, delete: if admin();
    }
    match /config/{id} {
      allow read: if true;
      allow write: if admin();
    }
  }
}
